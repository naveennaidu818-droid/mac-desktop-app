function delay(ms) {
  return new Promise((resolve) => setTimeout(resolve, ms));
}

self.addEventListener("notificationclick", (event) => {
  console.log("[SW] Notification clicked:", event.action, event.notification.data);
  const data = event.notification.data || {};
  const { type, conversationId, senderName, inviteId, groupName, callerName, callerNumber, isVideo } = data;

  event.notification.close();

  if (type === "sms") {
    event.waitUntil(handleOpenSmsAction({ conversationId }));
  } else if (type === "whatsapp") {
    event.waitUntil(handleOpenWhatsappAction({ conversationId }));
  } else if (type === "voicemail") {
    event.waitUntil(handleOpenVoicemailApp(data?.data?.voicemailId));
  } else if (type === "incoming-call" || type === "missed-call") {
    switch (event.action) {
      case "answer-audio":
        event.waitUntil(handleAnswerCall({ video: false, callerName, callerNumber, isVideo }));
        break;
      case "answer-video":
        event.waitUntil(handleAnswerCall({ video: true, callerName, callerNumber, isVideo }));
        break;
      case "decline":
        event.waitUntil(handleDeclineCall({ callerName, callerNumber }));
        break;
      case "call-back":
        event.waitUntil(handleCallBack({ callerNumber }));
        break;
      default:
        event.waitUntil(handleOpenCallApp());
        break;
    }
  } else {
    // Chat notification
    switch (event.action) {
      case "reply":
        event.waitUntil(handleReplyAction({ conversationId, senderName }));
        break;
      case "mark-read":
        event.waitUntil(handleMarkReadAction({ conversationId }));
        break;
      case "open-chat":
        event.waitUntil(handleOpenChatAction({ conversationId }));
        break;
      case "accept":
        event.waitUntil(handleAcceptGroupInvite({ inviteId, groupName }));
        break;
      case "decline":
        event.waitUntil(handleDeclineGroupInvite({ inviteId, groupName }));
        break;
      case "view-group":
        event.waitUntil(handleViewGroupInvite({ inviteId, groupName }));
        break;
      default:
        event.waitUntil(handleOpenChatAction({ conversationId }));
        break;
    }
  }
});

async function handleOpenVoicemailApp(voicemailId) {
  const suffix = voicemailId ? `?voicemailId=${encodeURIComponent(voicemailId)}` : "";
  const targetUrl = self.registration.scope + `voicemails${suffix}`;
  const clients = await self.clients.matchAll({ type: "window", includeUncontrolled: true });
  const client = clients.find((item) => item.url.includes("voicemails")) || clients[0];
  if (client) {
    await client.focus();
    await client.navigate(targetUrl);
    return client;
  }
  return self.clients.openWindow(targetUrl);
}

async function handleOpenCallApp() {
  try {
    const clients = await self.clients.matchAll({ type: "window", includeUncontrolled: true });
    for (const client of clients) {
      if (client.url.includes("calls")) {
        await client.focus();
        return client;
      }
    }
    for (const client of clients) {
      await client.focus();
      client.postMessage({
        type: "NAVIGATE_FROM_NOTIFICATION",
        payload: { to: "/calls", type: "incoming-call" }
      });
      return client;
    }
    return await self.clients.openWindow(self.registration.scope + "calls");
  } catch (error) {
    console.error("[SW] Error opening call app:", error);
  }
}

async function handleAnswerCall({ video, callerName, callerNumber, isVideo }) {
  try {
    const client = await handleOpenCallApp();
    if (client) {
      await delay(500);
      client.postMessage({
        type: "ANSWER_CALL_FROM_NOTIFICATION",
        payload: { video, callerName, callerNumber, isVideo }
      });
    }
  } catch (error) {
    console.error("[SW] Error answering call:", error);
  }
}

async function handleDeclineCall({ callerName, callerNumber }) {
  try {
    const clients = await self.clients.matchAll({ type: "window", includeUncontrolled: true });
    if (clients.length > 0) {
      clients[0].postMessage({
        type: "DECLINE_CALL_FROM_NOTIFICATION",
        payload: { callerName, callerNumber }
      });
    }
  } catch (error) {
    console.error("[SW] Error declining call:", error);
  }
}

