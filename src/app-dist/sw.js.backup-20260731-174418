self.addEventListener("message", (event) => {
  console.log("[SW] Message received:", event.data);
  const { type, payload } = event.data || {};

  switch (type) {
    case "SKIP_WAITING":
      self.skipWaiting();
      break;

    case "SHOW_INCOMING_CALL_NOTIFICATION":
      showIncomingCallNotification(payload);
      break;

    case "CLEAR_CALL_NOTIFICATIONS":
      clearAllCallNotifications();
      break;

    case "SHOW_NEW_MESSAGE_NOTIFICATION":
      showNewMessageNotification(payload);
      break;

    case "SHOW_TYPING_NOTIFICATION":
      showTypingNotification(payload);
      break;

    case "SHOW_GROUP_INVITE_NOTIFICATION":
      showGroupInviteNotification(payload);
      break;

    case "SHOW_MENTION_NOTIFICATION":
      showMentionNotification(payload);
      break;

    case "SHOW_SMS_NOTIFICATION":
      showSmsNotification(payload);
      break;

    case "SHOW_WHATSAPP_NOTIFICATION":
      showWhatsappNotification(payload);
      break;

    case "CLEAR_CHAT_NOTIFICATIONS":
      clearChatNotifications(payload);
      break;

    case "UPDATE_UNREAD_BADGE":
      updateUnreadBadge(payload);
      break;
  }
});

function showIncomingCallNotification({ callerName, callerNumber, isVideo }) {
  const callType = isVideo ? "Video Call" : "Audio Call";
  const title = `📞 VitelGlobal Connect`;
  const body = `${callType} from ${callerName}${callerNumber ? ` (${callerNumber})` : ""}`;

  const options = {
    body,
    icon: "/icon.png",
    badge: "/icon.png",
    tag: "incoming-call",
    requireInteraction: true,
    silent: false,
    vibrate: [200, 100, 200],
    data: {
      callerName,
      callerNumber,
      isVideo,
      type: "incoming-call"
    },
    actions: [
      {
        action: "answer-audio",
        title: "📞 Answer Audio"
      },
      ...(isVideo ? [{
        action: "answer-video",
        title: "🎥 Answer Video"
      }] : []),
      {
        action: "decline",
        title: "❌ Decline"
      }
    ]
  };

  self.registration.showNotification(title, options);
}

async function clearAllCallNotifications() {
  try {
    const notifications = await self.registration.getNotifications();
    notifications.forEach((notification) => {
      const tag = String(notification.tag || "").toLowerCase();
      const type = String(notification.data?.type || notification.data?.data?.type || "").toLowerCase();
      if (
        type === "incoming-call" ||
        type === "ringing" ||
        tag.startsWith("incoming-call") ||
        tag.startsWith("ringing") ||
        tag === "vitelglobal-active-call"
      ) {
        try {
          notification.close();
        } catch (err) { }
      }
    });
  } catch (error) {
    console.error("[SW] Error clearing call notifications:", error);
  }
}

