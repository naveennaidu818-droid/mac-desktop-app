const CACHE_NAME = "vitelglobal-offline-v8";
const SHELL_CACHE = "vitelglobal-shell-v3";
const ASSET_CACHE = "vitelglobal-assets-v3";

const SHELL_URLS = [
  "/",
  "/index.html",
  "/icon.png",
  "/manifest.json",
];

// Detect if running in Vite dev mode (localhost / 127.0.0.1).
// In production, Vite bundles all source into /assets/ with hashed filenames.
// The raw /src/ paths, /@vite/client, and /node_modules/ paths do NOT exist
// on the live server — attempting to fetch them causes CORS/404 errors.
const IS_DEV = (
  self.location.hostname === "localhost" ||
  self.location.hostname === "127.0.0.1" ||
  self.location.hostname === "::1" ||
  self.location.hostname.startsWith("192.168.") ||
  self.location.hostname.startsWith("10.")
);

// Vite dev-mode modules — ONLY available during local development.
const VITE_DEV_MODULES = [];

// Vite pre-bundled deps — ONLY available in dev mode under node_modules/.vite/deps/
const VITE_DEPS = [];

// Boot modules — raw /src/ paths only exist in Vite dev server.
// In production, everything is bundled into /assets/*.js by the build step.
const BOOT_MODULES = [];

// Route modules — raw /src/routes/ only exist in Vite dev server.
const ROUTE_MODULES = [];

// ============================================================================
// WORKBOX PRECACHE MANIFEST (injected by VitePWA at build time)
// ============================================================================
// In production builds, VitePWA replaces self.__WB_MANIFEST with the list of
// all built asset URLs (hashed filenames in /assets/). This is how the SW
// knows exactly which production files to precache without hardcoding them.
// In dev mode this array stays empty — dev assets are loaded live by Vite.
// IMPORTANT: Workbox requires exactly one reference to self.__WB_MANIFEST
// in the source file (this line). Do not add another reference.
const WB_MANIFEST = self.__WB_MANIFEST || [];

// Fetch and cache a URL, then recursively discover and cache any imported
// Vite dependency chunks from its source text. This ensures that pre-bundled
// deps like react-dom_client.js (which imports chunk-XXXXX.js) are fully
// cached, not just the top-level file.
async function fetchAndCacheWithImports(assetCache, url, seen = new Set()) {
  if (seen.has(url)) return;
  seen.add(url);
  let res;
  try {
    res = await fetch(url);
    if (!res.ok) return;
  } catch {
    return;
  }
  await assetCache.put(url, res.clone());

  // Only parse JS modules for imports (skip CSS/images)
  if (!url.match(/\.(js|mjs|jsx|ts|tsx)$/)) return;

  try {
    const text = await res.text();
    // Match static import statements: import "..." or import X from "..."
    const importRegex = /import\s+(?:(?:[\w*{}\s,]+)\s+from\s+)?["']([^"']+)["']/g;
    let match;
    while ((match = importRegex.exec(text)) !== null) {
      const specifier = match[1];
      // Resolve relative imports relative to the current file's directory
      const depUrl = specifier.startsWith(".")
        ? new URL(specifier, self.location.origin + url).pathname
        : specifier;
      // Only follow Vite deps and relative imports within the deps directory
      if (
        depUrl.startsWith("/node_modules/.vite/deps/") &&
        !seen.has(depUrl)
      ) {
        await fetchAndCacheWithImports(assetCache, depUrl, seen);
      }
    }
  } catch {
    // non-fatal; the main file is already cached
  }
}

self.addEventListener("install", (event) => {
  event.waitUntil(
    (async () => {
      // ── Phase 1: Pre-cache shell (blocking) ──────────
      const shellCache = await caches.open(SHELL_CACHE);
      for (const url of SHELL_URLS) {
        try {
          const response = await fetch(url);
          if (response.ok) await shellCache.put(url, response);
        } catch (err) {
          // non-fatal; navigation handler will fall through to network
        }
      }

      const assetCache = await caches.open(ASSET_CACHE);
      const seen = new Set();

      // ── Phase 2a: Pre-cache production assets from Workbox manifest ──
      // WB_MANIFEST is populated at build time by VitePWA with hashed /assets/ URLs.
      // In dev mode this is empty. In production it covers all built JS/CSS chunks.
      for (const entry of WB_MANIFEST) {
        const url = typeof entry === "string" ? entry : entry.url;
        if (!url || seen.has(url)) continue;
        seen.add(url);
        try {
          const response = await fetch(url);
          if (response.ok) await assetCache.put(url, response);
        } catch {
          // non-fatal
        }
      }

      // ── Phase 2b: Pre-cache boot modules + Vite deps (dev only) ───
      // BOOT_MODULES is empty in production (IS_DEV === false).
      for (const url of BOOT_MODULES) {
        try {
          await fetchAndCacheWithImports(assetCache, url, seen);
        } catch (err) {
          // Non-fatal: if one module fails, continue with others.
        }
      }

      // Activate immediately — don't wait for route modules
      await self.skipWaiting();

      // ── Phase 3: Pre-cache route modules (dev only, background, non-blocking) ──
      // ROUTE_MODULES is empty in production (IS_DEV === false).
      Promise.allSettled(
        ROUTE_MODULES.map((url) =>
          fetch(url)
            .then((res) => {
              if (res.ok) assetCache.put(url, res);
            })
            .catch(() => { })
        )
      );
    })()
  );
});

self.addEventListener("activate", (event) => {
  event.waitUntil(
    (async () => {
      const keys = await caches.keys();
      const keep = new Set([SHELL_CACHE, ASSET_CACHE]);
      await Promise.all(
        keys.filter((k) => !keep.has(k)).map((k) => caches.delete(k))
      );
      await self.clients.claim();
    })()
  );
});

function isApiRequest(url) {
  return url.pathname.startsWith("/api/") || url.pathname.startsWith("/uploads/");
}

function isSocketRequest(url) {
  return url.pathname.includes("/socket.io") || url.protocol === "ws:" || url.protocol === "wss:";
}

function isAssetRequest(url) {
  return (
    url.pathname.match(/\.(?:js|mjs|jsx|ts|tsx|css|png|jpg|jpeg|gif|svg|ico|woff2?|ttf|eot|json)$/) ||
    url.pathname.includes("/assets/")
  );
}

self.addEventListener("fetch", (event) => {
  const url = new URL(event.request.url);

  if (url.origin !== self.location.origin) return;
  if (event.request.method !== "GET") return;
  if (isSocketRequest(url)) return;

  if (IS_DEV) {
    event.respondWith(fetch(event.request));
    return;
  }

  if (isApiRequest(url)) {
    event.respondWith(handleApiRequest(event.request, url));
    return;
  }

  if (event.request.mode === "navigate") {
    event.respondWith(handleNavigationRequest(event.request));
    return;
  }

  if (isAssetRequest(url)) {
    event.respondWith(handleAssetRequest(event.request, url));
    return;
  }

  event.respondWith(handleAssetRequest(event.request, url));
});

async function handleNavigationRequest(request) {
  const url = new URL(request.url);

  // Always serve the cached app shell for offline SPA navigation.
  // This prevents the Chrome dinosaur page and keeps the app alive.
  const cachedShell = await caches.match("/index.html", { ignoreSearch: true });

  if (cachedShell) {
    // Update the cached shell in the background when back online (non-blocking)
    fetch(request)
      .then((res) => {
        if (res.ok) {
          caches.open(SHELL_CACHE).then((c) => c.put("/index.html", res));
        }
      })
      .catch(() => { });
    return cachedShell;
  }

  // No cached shell: try network, or fall back to a minimal SPA shell
  try {
    const response = await fetch(request);
    if (response.ok) {
      const cache = await caches.open(SHELL_CACHE);
      cache.put("/index.html", response.clone());
    }
    return response;
  } catch {
    // Minimal SPA shell so React can boot and read from RxDB
    const shell = `<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VitelGlobal</title>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.jsx"></script>
  </body>
</html>`;
    return new Response(shell, {
      status: 200,
      headers: { "Content-Type": "text/html; charset=utf-8" },
    });
  }
}

async function handleAssetRequest(request, url) {
  // If it's an SVG request imported by a script (destination is not image), bypass service worker cache
  if (url.pathname.endsWith(".svg") && request.destination !== "image") {
    return fetch(request);
  }

  // ignoreSearch to handle Vite cache-busting query params (?v=...)
  const cached = await caches.match(request, { ignoreSearch: true });
  if (cached) {
    fetch(request)
      .then((res) => {
        if (res.ok) {
          caches.open(ASSET_CACHE).then((c) => c.put(request, res));
        }
      })
      .catch(() => { });
    return cached;
  }

  try {
    const response = await fetch(request);
    if (response.ok) {
      const cache = await caches.open(ASSET_CACHE);
      cache.put(request, response.clone());
    }
    return response;
  } catch {
    if (url.pathname.match(/\.css$/)) {
      return new Response("", { status: 200, headers: { "Content-Type": "text/css; charset=utf-8" } });
    }
    return new Response("", { status: 503 });
  }
}

async function handleApiRequest(request, _url) {
  try {
    const response = await fetch(request);
    if (response.ok) {
      const cache = await caches.open(ASSET_CACHE);
      cache.put(request, response.clone());
    }
    return response;
  } catch {
    const cached = await caches.match(request);
    if (cached) return cached;
    return new Response(JSON.stringify({ error: "offline" }), {
      status: 503,
      headers: { "Content-Type": "application/json" },
    });
  }
}

