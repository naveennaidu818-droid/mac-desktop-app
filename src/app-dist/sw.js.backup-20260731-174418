async function handleOpenSmsApp(conversationId) {
  try {
    const clients = await self.clients.matchAll({ type: "window", includeUncontrolled: true });
    const targetPath = "sms" + (conversationId ? "?conversationId=" + encodeURIComponent(conversationId) : "");
    const targetUrl = self.registration.scope + targetPath;

    for (const client of clients) {
      if (client.url.includes("sms")) {
        await client.focus();
        client.postMessage({
          type: "NAVIGATE_FROM_NOTIFICATION",
          payload: { to: "/sms", type: "sms", conversationId }
        });
        return client;
      }
    }
    for (const client of clients) {
      await client.focus();
      client.postMessage({
        type: "NAVIGATE_FROM_NOTIFICATION",
        payload: { to: "/sms", type: "sms", conversationId }
      });
      return client;
    }
    return await self.clients.openWindow(targetUrl);
  } catch (error) {
    console.error("[SW] Error opening sms app:", error);
  }
}

async function handleOpenSmsAction({ conversationId }) {
  try {
    const client = await handleOpenSmsApp(conversationId);
    if (client) {
      await delay(500);
      client.postMessage({
        type: "OPEN_SMS_FROM_NOTIFICATION",
        payload: { conversationId }
      });
    }
  } catch (error) {
    console.error("[SW] Error opening sms:", error);
  }
}

