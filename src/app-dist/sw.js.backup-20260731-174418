      self.navigator.setAppBadge(count > 0 ? count : 0);
    }
  } catch (error) {
    console.warn("[SW] Could not update app badge:", error);
  }
}

function decodeHtmlEntities(str) {
  if (!str || typeof str !== "string") return str || "";
  let result = str;
  let previous = "";
  let passes = 0;
  while (result !== previous && passes < 2) {
    previous = result;
    passes++;
    result = result
      .replace(/&#(\d+);/g, (_, dec) => String.fromCharCode(Number(dec)))
      .replace(/&#x([0-9a-fA-F]+);/g, (_, hex) => String.fromCharCode(parseInt(hex, 16)))
      .replace(/&quot;/g, '"')
      .replace(/&apos;/g, "'")
      .replace(/&#39;/g, "'")
      .replace(/&#96;/g, "`")
      .replace(/&amp;/g, "&")
      .replace(/&lt;/g, "<")
      .replace(/&gt;/g, ">")
      .replace(/&nbsp;/g, " ");
  }
  return result;
}

function showSmsNotification({ senderName, messagePreview, conversationId }) {
  const cleanSender = decodeHtmlEntities(senderName);
  const cleanPreview = decodeHtmlEntities(messagePreview);
  const title = `✉️ New SMS from ${cleanSender}`;
  const options = {
    body: cleanPreview,
    icon: "/icon.png",
    badge: "/icon.png",
    tag: `sms-${conversationId}-${Date.now()}`,
    renotify: true,
    requireInteraction: true,
    data: {
      type: "sms",
      conversationId,
      senderName: cleanSender,
      messagePreview: cleanPreview
    },
    actions: [
      {
        action: "open-sms",
        title: "💬 View SMS"
      }
    ]
  };
  self.registration.showNotification(title, options);
}

