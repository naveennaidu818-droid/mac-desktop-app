}

async function handleOpenChatApp(conversationId) {
  try {
    const clients = await self.clients.matchAll({ type: "window", includeUncontrolled: true });
    const targetPath = conversationId ? `chat?conversationId=${conversationId}` : "chat";
    const targetUrl = self.registration.scope + targetPath;

    for (const client of clients) {
      if (client.url.includes("chat")) {
        await client.focus();
        client.postMessage({
          type: "NAVIGATE_FROM_NOTIFICATION",
          payload: { to: "/chat", type: "chat", conversationId }
        });
        return client;
      }
    }
    for (const client of clients) {
      await client.focus();
      client.postMessage({
        type: "NAVIGATE_FROM_NOTIFICATION",
        payload: { to: "/chat", type: "chat", conversationId }
      });
      return client;
    }
    return await self.clients.openWindow(targetUrl);
  } catch (error) {
    console.error("[SW] Error opening chat app:", error);
  }
}

